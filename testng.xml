<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="BlazeDemo Test Suite">

	<test name="Smoke Tests">
		<groups>
			<run>
				<include name="smoke" />
			</run>
		</groups>

		<classes>
			<class name="tests.FlightBookingTest" />
		</classes>
	</test>

	<test name="Functional Tests">
		<groups>
			<run>
				<include name="functional" />
			</run>
		</groups>

		<classes>
			<class name="tests.FlightBookingTest" />
		</classes>
	</test>

	<test name="Negative Tests">
		<groups>
			<run>
				<include name="negative" />
			</run>
		</groups>

		<classes>
			<class name="tests.FlightBookingTest" />
		</classes>
	</test>

</suite>